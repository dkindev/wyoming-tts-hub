# Environment variables template
# Copy this file to .env and update values as needed
#
# Every value here matches the one config.yml ships, because environment variables
# outrank that file: copying this template as-is changes nothing about the server.

# Infrastructure
TTS_ENV_TYPE=production
TTS_URI=tcp://127.0.0.1:10200
TTS_ZEROCONF=wyoming-tts-hub
TTS_STREAMING=true

# Strict runtime allowlist of model ids this instance serves (JSON array).
TTS_ACTIVE_MODELS=["silero_ru"]

# Model ids to preload at startup (JSON array). Each id must also be active.
TTS_WARMUP_MODELS=["silero_ru"]

# Voice ids in '<model id>-<voice name>' form to pre-build Voice Prompts for at
# startup, up to max_voice_prompts (JSON array).
TTS_WARMUP_VOICES=[]

# PyTorch computing engine
TTS_TORCH__DEVICE=cpu
TTS_TORCH__NUM_THREADS=4
TTS_TORCH__NUM_INTEROP_THREADS=1
TTS_TORCH__FLUSH_DENORMAL=true

# Model cache and synthesis
TTS_MAX_MODELS=2
TTS_MAX_VOICE_PROMPTS=8
TTS_CACHE_HALF_LIFE=60
TTS_INFERENCE_TIMEOUT=5
TTS_FRAME_DURATION=50
TTS_MAX_CONCURRENT_SENTENCES_PER_MODEL=2
TTS_MAX_SENTENCE_CHARS=140
TTS_DATA_YML_PATH=data/data.yml
TTS_MODELS_DIR=models

# Silero TTS Engine
TTS_SILERO__SAMPLE_RATE=48000
TTS_SILERO__MODELS_YML_URL=https://raw.githubusercontent.com/snakers4/silero-models/refs/heads/master/models.yml
# SHA-256 of the registry file above. Leave empty to skip integrity validation.
TTS_SILERO__MODELS_YML_HASH=

# Text normalization
TTS_NORMALIZATION__TIMEOUT=5
TTS_NORMALIZATION__MAX_CONCURRENT_SENTENCES_PER_REQUEST=2
TTS_NORMALIZATION__TEXT__ENABLED=true
TTS_NORMALIZATION__TEXT__TYPE=simple
TTS_NORMALIZATION__SSML__ENABLED=false
TTS_NORMALIZATION__SSML__TYPE=simple

# OpenAI-compatible API, for LLM-based normalization
TTS_NORMALIZATION__OPENAI__BASE_URL=
TTS_NORMALIZATION__OPENAI__API_KEY=
